# Copy to .env and fill in. .env is git-ignored and must never be committed or shared.
# Values here are never printed in full in logs (redaction filter).

# ---- One-line switches (override config/config.yaml) ----
# ACTIVE_AI_PROVIDER: empty = config.yaml (claude_code); or gemini | anthropic | openai | grok | groq | openrouter | deepseek | ollama
ACTIVE_AI_PROVIDER=
# AI_FALLBACK_PROVIDER: empty = config.yaml (gemini) - used while the active provider is unavailable
AI_FALLBACK_PROVIDER=
# AGENT_MODE: empty = use config.yaml (agent_per_pair)
AGENT_MODE=
# TRIGGER_POLICY: every_close | on_setup_event | hybrid
TRIGGER_POLICY=
# EXECUTION_MODE: paper | demo | live
EXECUTION_MODE=
# EXECUTION_TRIGGER: manual | auto
EXECUTION_TRIGGER=
# RESOURCE_PROFILE: low | standard
RESOURCE_PROFILE=

# ---- Claude on your Claude subscription (Claude Code CLI, D-030) - no API key ----
# Either sign in once with `claude auth login`, or paste a long-lived token from `claude setup-token` here.
# ANTHROPIC_API_KEY is never passed to the CLI, so these calls cannot be billed per token.
CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_CODE_MODEL: empty = config default (sonnet); opus = deeper but uses the limits faster
CLAUDE_CODE_MODEL=

# ---- Google Gemini (free tier available) ----
GOOGLE_API_KEY=
# GEMINI_MODEL: empty = config default (gemini-3.8-flash)
GEMINI_MODEL=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL: e.g. claude-sonnet-5 / claude-opus-5-5
ANTHROPIC_MODEL=

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- xAI Grok ----
XAI_API_KEY=
GROK_MODEL=

# ---- Free / low-cost options ----
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
OLLAMA_MODEL=

# ---- MetaTrader 5 (optional: leave empty to attach to the already logged-in terminal) ----
MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_LIVE_LOGIN=
MT5_LIVE_PASSWORD=

# ---- Binance (only if Binance execution is enabled later; data needs no keys) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Dashboard ----
# DASHBOARD_TOKEN: long random string; required by the Execute endpoint
DASHBOARD_TOKEN=

# ---- Notifications (Phase 4, optional - docs/notifications.md section 1) ----
# A Telegram bot of your own (BotFather) and your chat id. Empty = Windows toast + log only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
